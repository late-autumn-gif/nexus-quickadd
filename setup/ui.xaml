<?xml version="1.0" encoding="utf-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="20">
  <Grid.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="#2563EB" CornerRadius="10" Padding="22,10">
              <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.28" Color="#2563EB"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#1D4ED8"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#1E40AF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Background" Value="#C7D2E5"/>
                <Setter TargetName="Bg" Property="Effect" Value="{x:Null}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="#5B6472"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="14,8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#F2F4F8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#C3CAD6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StepText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="#9AA4B5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,7,0,7"/>
    </Style>
  </Grid.Resources>

  <Border x:Name="Root" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E7EAF0" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.18" Color="#0F172A"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- header -->
      <Grid x:Name="HeaderBar" Height="76">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
          <Border Width="38" Height="38" CornerRadius="11">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3B82F6" Offset="0"/>
                <GradientStop Color="#1D4ED8" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Data="M 6.5,1.2 A 5.3,5.3 0 1 0 6.5,11.8 A 5.3,5.3 0 1 0 6.5,1.2 M 10.6,10.6 L 15,15"
                    Stroke="#FFFFFF" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Viewbox>
          </Border>
          <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Nexus 速添版 · 安装" FontSize="16.5" FontWeight="SemiBold" Foreground="#0F172A"/>
            <TextBlock Text="一步装好 Winstep Nexus 与速添搜索添加，并自动放进停靠栏"
                       FontSize="11.5" Foreground="#98A2B3" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>
        <Button x:Name="CloseButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,12,10,0" Content="✕" FontSize="13" ToolTip="关闭"/>
      </Grid>

      <!-- body -->
      <StackPanel Grid.Row="1" Margin="24,0,24,0">
        <Border x:Name="DetectBox" Background="#F5F9FF" BorderBrush="#DCE9FF" BorderThickness="1" CornerRadius="10" Padding="14,12">
          <TextBlock x:Name="DetectText" Text="正在检测 Nexus…" FontSize="12.5" Foreground="#2563EB" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="4,18,0,0">
          <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="#CBD5E1" VerticalAlignment="Center"/>
          <TextBlock x:Name="Step1" Style="{StaticResource StepText}" Text="1  准备 Nexus（已安装则跳过）" Margin="10,7,0,7"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
          <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="#CBD5E1" VerticalAlignment="Center"/>
          <TextBlock x:Name="Step2" Style="{StaticResource StepText}" Text="2  安装速添并登记卸载项" Margin="10,7,0,7"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
          <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="#CBD5E1" VerticalAlignment="Center"/>
          <TextBlock x:Name="Step3" Style="{StaticResource StepText}" Text="3  写进 Nexus 停靠栏" Margin="10,7,0,7"/>
        </StackPanel>

        <ProgressBar x:Name="Progress" Height="4" Margin="4,14,4,0" Minimum="0" Maximum="100" Value="0"
                     Foreground="#2563EB" Background="#E7EAF0" BorderThickness="0" Visibility="Collapsed"/>
        <TextBlock x:Name="DetailText" Text="" FontSize="11.5" Foreground="#98A2B3" Margin="4,10,0,0" TextWrapping="Wrap"/>
      </StackPanel>

      <!-- footer -->
      <Grid Grid.Row="2" Height="76" Margin="24,0,20,0">
        <TextBlock x:Name="VersionText" Text="v1.1.0" FontSize="11" Foreground="#C3CAD6" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="UninstallButton" Style="{StaticResource GhostButton}" Content="卸载" Margin="0,0,6,0"/>
          <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Content="一键安装"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Grid>
